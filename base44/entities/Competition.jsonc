{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Competition name e.g. Confex 2027"
    },
    "event_location": {
      "type": "string",
      "description": "Venue / city of the trade show"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "icp_multiplier": {
      "type": "number",
      "default": 1.25,
      "minimum": 1,
      "maximum": 2,
      "description": "Multiplier applied to each ICP round score"
    },
    "round_count": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 5,
      "description": "Number of venues played in a full game"
    },
    "round_seconds": {
      "type": "integer",
      "default": 30,
      "minimum": 15,
      "maximum": 90,
      "description": "Time allowed for each round"
    },
    "kiosk_idle_seconds": {
      "type": "integer",
      "default": 90,
      "minimum": 30,
      "maximum": 300,
      "description": "Seconds without interaction before the kiosk resets"
    },
    "map_latitude": {
      "type": "number",
      "default": 54.5,
      "minimum": -85,
      "maximum": 85
    },
    "map_longitude": {
      "type": "number",
      "default": -3.5,
      "minimum": -180,
      "maximum": 180
    },
    "map_zoom": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 18
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
