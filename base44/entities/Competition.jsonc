{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Competition name e.g. Confex 2027"
    },
    "event_location": {
      "type": "string",
      "description": "Event venue/city"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "Only one competition should be active at a time"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}