{
  "name": "PendingSubmission",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Unique random token encoded in the QR code URL"
    },
    "competition_id": {
      "type": "string"
    },
    "game_session_id": {
      "type": "string",
      "description": "Verified game session used to calculate this score"
    },
    "total_score": {
      "type": "number"
    },
    "round_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "venue_name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "distance_km": {
            "type": "number"
          }
        }
      }
    },
    "avg_distance_km": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "expired"
      ],
      "default": "pending"
    },
    "icp_boosted": {
      "type": "boolean",
      "default": false,
      "description": "True if the stored total_score was ICP-boosted on the kiosk"
    },
    "lead_id": {
      "type": "string",
      "description": "Lead created when this submission is finalized"
    },
    "leaderboard_entry_id": {
      "type": "string",
      "description": "Leaderboard entry created when this submission is finalized"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "description": "True after the post-game email has been sent"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time after which an unfinished anonymous submission is invalid"
    },
    "request_fingerprint": {
      "type": "string",
      "description": "Privacy-safe hash used only for anonymous submission rate limiting"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
