{
  "name": "LeaderboardEntry",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string",
      "description": "Display name of the player"
    },
    "email": {
      "type": "string",
      "description": "Player email"
    },
    "total_score": {
      "type": "number",
      "description": "Total score across all rounds"
    },
    "rounds_played": {
      "type": "number",
      "description": "Number of rounds played"
    },
    "avg_distance_km": {
      "type": "number",
      "description": "Average distance in km"
    },
    "icp_boosted": {
      "type": "boolean",
      "default": false,
      "description": "True if the total_score was boosted via the ICP boost"
    }
  },
  "required": [
    "player_name",
    "total_score"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
