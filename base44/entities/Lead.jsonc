{
  "name": "Lead",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "mailjet_synced": {
      "type": "boolean",
      "default": false
    },
    "icp_boosted": {
      "type": "boolean",
      "default": false,
      "description": "True if this lead received the ICP score boost"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}