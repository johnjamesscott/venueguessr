{
  "name": "Venue",
  "type": "object",
  "properties": {
    "venue_name": {
      "type": "string"
    },
    "space_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "matterport_url": {
      "type": "string",
      "description": "Full Matterport tour URL"
    },
    "headbox_url": {
      "type": "string",
      "description": "HeadBox listing URL"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Demo-only venue, excluded from live game"
    }
  },
  "required": [
    "venue_name",
    "matterport_url",
    "latitude",
    "longitude"
  ]
}