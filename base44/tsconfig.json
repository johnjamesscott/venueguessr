{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "useUnknownInCatchVariables": false
  },
  "include": ["functions/**/*.ts", "functions/**/*.js", "types.d.ts"]
}
