{
  "name": "GameSession",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Short-lived random token used to verify a public game"
    },
    "competition_id": {
      "type": "string"
    },
    "venue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowed primary and spare venue IDs for this game"
    },
    "round_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "icp_multiplier": {
      "type": "number",
      "minimum": 1,
      "maximum": 2
    },
    "icp_boosted": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "expired"
      ],
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_submission_id": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "venue_ids",
    "round_count"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
