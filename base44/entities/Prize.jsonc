{
  "name": "Prize",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string",
      "description": "ID of the linked Competition"
    },
    "position": {
      "type": "number",
      "description": "Leaderboard position e.g. 1 = 1st place"
    },
    "prize_name": {
      "type": "string",
      "description": "e.g. PS5, AirPods"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "competition_id",
    "position",
    "prize_name"
  ]
}