{
  "name": "Prize",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "position": {
      "type": "number",
      "description": "1 = 1st place, 2 = 2nd place, etc."
    },
    "prize_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "competition_id",
    "position",
    "prize_name"
  ],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
